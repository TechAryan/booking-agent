# Public https address of the app (no trailing slash). Used in widget code and WhatsApp webhooks.
# Not needed on Render/Railway (they provide it); needed with a tunnel.
PUBLIC_URL=http://localhost:3000
PORT=3000

# Long random string (e.g. `openssl rand -base64 48`). Encrypts customers' API keys.
# Keep it safe and NEVER change it after going live, or stored keys can't be read.
APP_SECRET=

# Database. Leave TURSO_* empty to use a local SQLite file (fine on your laptop or a Railway volume).
DATABASE_PATH=./data/app.db
# Hosted database (Turso, free). Set both on Render; keep the same values if you move hosts.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# First admin, created on first start only (change the password after logging in).
ADMIN_EMAIL=
ADMIN_PASSWORD=

APP_NAME=Booking Agent
# Default Claude model for new customers
CLAUDE_MODEL=claude-sonnet-5-5

# "Sign in with Google" for your customers' calendars (recommended). Create an OAuth client in Google Cloud
# (see README → Google sign-in). Redirect URI: <PUBLIC_URL>/setup/google/callback. Leave empty to use key files only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Edge worker (optional, recommended on free hosting): once edge/ is deployed on Cloudflare, put its URL here so
# new WhatsApp/Razorpay webhooks point at it. Leave empty to receive webhooks on this app directly.
WEBHOOK_BASE_URL=

# Photo storage (optional): Cloudflare R2. Payment screenshots go here instead of the database.
# Leave empty to keep photos in the database (fine for testing and the first customers).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=booking-agent-files
# Safety cap in GB (R2 is free up to 10 GB) and how long screenshots are kept.
R2_MAX_GB=9
PHOTO_KEEP_DAYS=180
